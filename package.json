{
  "name": "client-platform-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "pdf-server": "node server/pdf-server.js",
    "lint": "eslint",
    "verify:public-tests": "tsc scripts/verify-public-test-admin.ts src/lib/publicTests.ts src/lib/api.ts --outDir .verify --module commonjs --target es2020 --moduleResolution node --lib es2020,dom --skipLibCheck --esModuleInterop --types node && node .verify/scripts/verify-public-test-admin.js",
    "sync:client-core": "node scripts/sync-client-core.js",
    "verify:client-core": "node scripts/sync-client-core.js --check",
    "verify": "npm run verify:public-tests && npm run verify:tenant && npm run verify:client-core",
    "verify:tenant": "tsc scripts/verify-tenant-access.ts src/lib/tenant/access.ts src/lib/tenant/registry.ts src/lib/tenant/branding.ts --outDir .verify --module commonjs --target es2020 --moduleResolution node --lib es2020,dom --skipLibCheck --esModuleInterop --types node && node .verify/scripts/verify-tenant-access.js"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@heroicons/react": "^2.2.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@sparticuz/chromium": "^138.0.2",
    "body-parser": "^2.2.0",
    "docx": "^9.5.1",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "file-saver": "^2.0.5",
    "firebase": "^12.7.0",
    "framer-motion": "^12.23.13",
    "html2pdf.js": "^0.12.1",
    "idb-keyval": "^6.3.0",
    "katex": "^0.16.27",
    "lucide-react": "^0.544.0",
    "next": "^15.5.9",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.4.449",
    "puppeteer": "^24.22.0",
    "puppeteer-core": "^24.22.0",
    "react": "19.1.0",
    "react-calendar": "^6.0.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.5.0",
    "react-katex": "^3.1.0",
    "recharts": "^3.2.1",
    "sharp": "^0.33.5",
    "sonner": "^2.0.7",
    "tesseract.js": "^6.0.1",
    "tesseract.js-node": "^0.1.0",
    "xlsx": "^0.18.5",
    "@platform/client-core": "file:./vendor/client-core"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-calendar": "^3.9.0",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}